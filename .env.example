# Local development only. Do not reuse these values outside an isolated machine.
ASTERIA_ENV=development
ASTERIA_SERVER_ADDRESS=127.0.0.1:8080
ASTERIA_AUTH_MODE=trusted-dev
ASTERIA_TRUSTED_TOKENS_JSON={"local-development-token-change-me-000000000000":{"tenant_id":"11111111-1111-4111-8111-111111111111","principal_id":"aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa","tenant_name":"Local Asteria"}}
ASTERIA_CURSOR_HMAC_KEY=local-cursor-hmac-key-change-me-000000000000

ASTERIA_METADATA_DRIVER=postgres
ASTERIA_DATABASE_URL=postgres://asteria:local-asteria-password@127.0.0.1:15432/asteria?sslmode=disable
ASTERIA_AUTO_MIGRATE=true

ASTERIA_STORAGE_DRIVER=s3
ASTERIA_S3_ENDPOINT=http://127.0.0.1:18333
ASTERIA_S3_REGION=us-east-1
ASTERIA_S3_BUCKET=asteria-drive-local
ASTERIA_S3_ACCESS_KEY_ID=asteria-local-access
ASTERIA_S3_SECRET_ACCESS_KEY=asteria-local-secret-not-for-production
ASTERIA_S3_PATH_STYLE=true
ASTERIA_S3_AUTO_CREATE_BUCKET=true
ASTERIA_S3_CHECKSUM_HEADERS=false
